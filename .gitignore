# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# --- Env ---
.env
.env.local
.env.*.local

# --- Secrets (defense in depth -- nothing here should exist, but if it
# does, never let it get committed by accident) ---
*.pem
*.key

# --- Database ---
*.db
*.sqlite3

# --- Logs ---
*.log

# --- Vector store / data ---
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/vector_index/*
!backend/data/vector_index/.gitkeep

# --- Node / frontend ---
node_modules/
dist/
frontend/.env

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store

# --- Claude Code tooling (local/machine-specific, not app config) ---
.claude/
