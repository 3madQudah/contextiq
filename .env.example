# --- Auth ---
SECRET_KEY=changeme_generate_a_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
DATABASE_URL=sqlite:///./contextiq.db

# --- External DB connections (text-to-SQL feature) ---
# Fernet key used to encrypt saved connection strings at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this secret and stable — rotating it makes existing saved connections
# undecryptable (their encrypted_connection_string was encrypted under the old key).
DB_ENCRYPTION_KEY=changeme_generate_a_fernet_key

# --- LLM (Groq) ---
# Free API key: https://console.groq.com/keys
GROQ_API_KEY=changeme_your_groq_api_key

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:5173