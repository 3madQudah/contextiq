# --- Auth ---
SECRET_KEY=-<your-secret-key>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (the app's own DB — users/conversations/messages/db_connections,
# NOT the external databases users connect for the text-to-SQL feature, which
# is unrelated and configured per-connection in the UI instead) ---
# Local dev (default):
DATABASE_URL=sqlite:///./contextiq.db
# Production (e.g. Render Postgres) — swap in the connection string Render
# gives you. "postgres://" (Heroku-style) works too; it's normalized to
# "postgresql://" automatically in auth/database.py.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- External DB connections (text-to-SQL feature) ---
# Fernet key used to encrypt saved connection strings at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this secret and stable — rotating it makes existing saved connections
# undecryptable (their encrypted_connection_string was encrypted under the old key).
DB_ENCRYPTION_KEY=<your-fernet-key>

# --- LLM (Groq) ---
# Free API key: https://console.groq.com/keys
GROQ_API_KEY=<your-groq-api-key>

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Docker Compose only (docker-compose.yml at the project root) ---
# Not read by `uvicorn`/`vite dev` run directly on the host — only by
# `docker-compose build`/`up`. For non-Docker local frontend dev, use
# frontend/.env.example instead (same variable, different file/purpose).
#
# Baked into the frontend's static JS bundle at *build* time (see
# frontend/Dockerfile) — must be reachable from your browser, e.g.
# http://localhost:8000 (the backend's published port in docker-compose.yml),
# never the internal Docker network name "http://backend:8000". Changing
# this requires `docker-compose up --build`, not just a restart.
VITE_API_BASE_URL=http://localhost:8000
# Optional override for the backend container's DATABASE_URL. Leave unset to
# use SQLite at a path inside the backend_data volume (persists across
# `docker-compose down`/rebuilds — see docker-compose.yml's comment on why
# the plain DATABASE_URL default above isn't safe to reuse as-is inside the
# container). Set this to swap in Postgres/MySQL instead, e.g.:
# DOCKER_DATABASE_URL=postgresql://user:password@host:5432/dbname
# DOCKER_DATABASE_URL=